<Window x:Class="PageCounterPro.UI.Views.FileTypeOptionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PageCounterPro.UI.ViewModels"
        xmlns:converters="clr-namespace:PageCounterPro.UI.Converters"
        mc:Ignorable="d"
        Title="{Binding Title}" 
        Height="500" 
        Width="550"
        MinHeight="400"
        MinWidth="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BackgroundBrush}">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
    </Window.Resources>
    
    <Window.DataContext>
        <vm:FileTypeOptionsViewModel/>
    </Window.DataContext>
    
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{Binding Title}" 
                       FontSize="20" 
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,0,0,8"/>
            <TextBlock Text="{Binding Description}" 
                       FontSize="14"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap"/>
        </StackPanel>
        
        <!-- File Type List -->
        <Border Grid.Row="1" 
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                <ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Expander IsExpanded="True" Margin="0,0,0,12">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding CategoryIcon}" FontSize="16" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding CategoryName}" 
                                                   FontWeight="SemiBold" 
                                                   FontSize="14"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text=" (" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14"/>
                                        <TextBlock Text="{Binding TotalFiles}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14"/>
                                        <TextBlock Text=" files)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14"/>
                                    </StackPanel>
                                </Expander.Header>
                                <ItemsControl ItemsSource="{Binding FileTypes}" Margin="24,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource BackgroundBrush}" 
                                                    CornerRadius="6" 
                                                    Padding="12,10"
                                                    Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="60"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <!-- Extension -->
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                        <TextBlock Text="." 
                                                                   FontWeight="Bold"
                                                                   FontSize="14"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                                        <TextBlock Text="{Binding Extension}" 
                                                                   FontWeight="Bold"
                                                                   FontSize="14"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    </StackPanel>
                                                    
                                                    <!-- File count -->
                                                    <TextBlock Grid.Column="1" 
                                                               FontSize="12"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               VerticalAlignment="Center">
                                                        <Run Text="{Binding FileCount, Mode=OneWay}"/>
                                                        <Run Text=" files"/>
                                                    </TextBlock>
                                                    
                                                    <!-- Options -->
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <CheckBox IsChecked="{Binding CountAs1Page}"
                                                                  Content="Count as 1 page"
                                                                  VerticalAlignment="Center"
                                                                  Margin="0,0,16,0"/>
                                                        
                                                        <CheckBox IsChecked="{Binding ShowDuration}"
                                                                  Content="Show duration"
                                                                  VerticalAlignment="Center"
                                                                  Visibility="{Binding CanShowDuration, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                  IsEnabled="{Binding MetadataReadable}"/>
                                                    </StackPanel>
                                                    
                                                    <!-- Metadata warning -->
                                                    <TextBlock Grid.Column="3"
                                                               Text="⚠️ Metadata unreadable"
                                                               FontSize="11"
                                                               Foreground="{StaticResource WarningBrush}"
                                                               VerticalAlignment="Center"
                                                               Visibility="{Binding MetadataReadable, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        
        <!-- Footer Buttons -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Cancel" 
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding CancelCommand}"
                    Width="100"
                    Margin="0,0,12,0"/>
            <Button Content="Apply" 
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding OkCommand}"
                    Width="100"/>
        </StackPanel>
    </Grid>
</Window>
